include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include ruff.toml
recursive-include docs *.md

# "The source is the specification": the sdist ships the tests that hold the
# claims, their fixtures and the Linux harness. By file type, never `graft`: a
# graft ships whatever else sits in a working tree (a .env, a test vault, a
# cache). scripts/check.sh also refuses a build that holds a file git does not see.
recursive-include tests *.py *.json *.md
include tests/linux/Containerfile
recursive-include scripts *.py *.sh

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
# Local state and secrets, wherever they are, even with a shipped file type.
global-exclude .env .env.* .envrc *.irondome *.state *.local.json .mcp.json
global-exclude .claude/** .hypothesis/** .pytest_cache/** .mypy_cache/** .ruff_cache/** .venv/**
